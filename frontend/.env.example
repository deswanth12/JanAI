# JanAI Frontend Environment Variables Specification

# Active API Base URL (Set per deployment environment)
# Development: http://localhost:8000
# Staging/Preview: https://preview-api.janai.in
# Production: https://api.janai.in
VITE_API_URL=http://localhost:8000

# Optional Feature Flags
VITE_ENABLE_VOICE_ASSISTANT=true
VITE_ENABLE_DIGILOCKER_SANDBOX=true
